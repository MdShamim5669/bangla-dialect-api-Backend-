# ==========================================
# Bangla Dialect Translator - Backend Config Example
# ==========================================

# Server Port (default 8000)
PORT=8000

# Hugging Face Model Repository ID (e.g. username/repo-name)
HF_REPO_ID=samim5669/banglat5-dialect-to-standard

# Hugging Face Access Token (get one from https://huggingface.co/settings/tokens)
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Allowed CORS Origins (comma-separated or *)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,*
